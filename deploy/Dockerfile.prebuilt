FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/
COPY 40-app-name.sh /docker-entrypoint.d/40-app-name.sh
# 原件只在构建时写入。容器每次启动从这里生成对外的 index.html 与 config.json。
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-app-name.sh \
    && chmod 755 /docker-entrypoint.d/40-app-name.sh \
    && mkdir -p /usr/share/nginx/html-orig \
    && cp /usr/share/nginx/html/index.html /usr/share/nginx/html-orig/index.html \
    && if [ -f /usr/share/nginx/html/config.json ]; then \
         cp /usr/share/nginx/html/config.json /usr/share/nginx/html-orig/config.json; \
       fi
EXPOSE 80
